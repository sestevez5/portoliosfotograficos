# Copia este fichero a ".env" (no versionado) y ajusta los valores para tu NAS.

# Ruta absoluta en el host (NAS) de la carpeta de fotos (<fotógrafo>/<portfolio>/<álbum>/...).
# Es lo único que se monta desde el host y debe ser escribible por el contenedor (el backend crea,
# renombra y borra carpetas). La base de datos y los logos son internos: van en el volumen de
# Docker "datos-internos" (ver docker-compose.yml); la base de datos se crea vacía si no existe.
FOTOS_PATH=/volume1/docker/portfolio-fotografico/fotos

# Puerto publicado en el NAS para acceder al frontend (sirve también /api y /photos).
FRONTEND_PORT=8080
