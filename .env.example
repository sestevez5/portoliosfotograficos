# Copia este fichero a ".env" (no versionado) y ajusta los valores para tu NAS.

# Ruta absoluta en el host (NAS) donde vive la carpeta "datos"
# (backend/datos/fotos, backend/datos/logos y backend/datos/estructura/organizacionFotos.json).
# Debe ser escribible por el contenedor: el backend guarda ahí los logos que genera y actualiza el JSON.
DATOS_PATH=/volume1/docker/portfolio-fotografico/datos

# Puerto publicado en el NAS para acceder al frontend (sirve también /api y /photos).
FRONTEND_PORT=8080
