# Copia este fichero a ".env" (no versionado) y ajusta los valores para tu NAS.

# Ruta absoluta en el host (NAS) de la carpeta de fotos (<fotógrafo>/<portfolio>/<colección>/...).
# Debe ser escribible por el contenedor (el backend crea, renombra y borra carpetas).
FOTOS_PATH=/volume1/docker/portfolio-fotografico/contenido/fotos

# Ruta absoluta en el host de la carpeta de datos de la aplicación: base de datos (BD/), logos,
# miniaturas y fotos de perfil. Junto a la de fotos, para que las copias de seguridad las incluyan
# a las dos; no la metas dentro de la de fotos. Es interna de la aplicación: no toques nada dentro
# mientras esté en marcha. Si se deja sin definir, estos datos van en el volumen interno de Docker
# "datos-internos" (no visible en el host). La base de datos se crea vacía si no existe.
DATOS_PATH=/volume1/docker/portfolio-fotografico/contenido/datos

# Puerto publicado en el NAS para acceder al frontend (sirve también /api y /photos).
FRONTEND_PORT=8080
