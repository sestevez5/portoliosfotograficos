# Copia este fichero a ".env" (no versionado) y ajusta los valores para tu NAS.

# Ruta absoluta en el host (NAS) donde vive la carpeta "datos"
# (fotos/, logos/, estructura/portfolio.db y estructura/organizacionFotos.json).
# Debe ser escribible por el contenedor: el backend guarda ahí la base de datos SQLite y los logos.
# Si no existe estructura/portfolio.db, el backend la crea al arrancar importando el JSON.
DATOS_PATH=/volume1/docker/portfolio-fotografico/datos

# Puerto publicado en el NAS para acceder al frontend (sirve también /api y /photos).
FRONTEND_PORT=8080
