# Copia este fichero a ".env" (no versionado) y ajusta los valores para tu NAS.

# Ruta absoluta en el host (NAS) de la carpeta de fotos (<fotógrafo>/<portfolio>/<colección>/...).
# Debe ser escribible por el contenedor (el backend crea, renombra y borra carpetas).
FOTOS_PATH=/volume1/docker/portfolio-fotografico/contenido/fotos

# Ruta absoluta en el host de la carpeta de datos de la aplicación: base de datos (BD/), logos,
# miniaturas y fotos de perfil. Junto a la de fotos, para que las copias de seguridad las incluyan
# a las dos; no la metas dentro de la de fotos. Es interna de la aplicación: no toques nada dentro
# mientras esté en marcha. Si se deja sin definir, estos datos van en el volumen interno de Docker
# "datos-internos" (no visible en el host). La base de datos se crea vacía si no existe.
DATOS_PATH=/volume1/docker/portfolio-fotografico/contenido/datos

# Puerto publicado en el NAS para acceder al frontend (sirve también /api y /photos).
FRONTEND_PORT=8080

# Dirección con la que se abre la web desde fuera (la del navegador), sin "/" al final. Con ella se
# construyen los enlaces de los correos para recuperar la contraseña, así que debe ser accesible
# desde donde se lean esos correos. Por ejemplo: http://192.168.1.50:8080 o https://fotos.midominio.es
PUBLIC_URL=http://192.168.1.50:8080

# Servidor de correo saliente (SMTP) para enviar los enlaces de "¿Has olvidado tu contraseña?". Sin
# SMTP_HOST no se envía ningún correo (el enlace solo aparece en el registro del backend:
# "docker compose logs backend"). Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_SECURE=true, SMTP_USER=tu.cuenta@gmail.com y como SMTP_PASSWORD una "contraseña de aplicación"
# de Google (no la de la cuenta). SMTP_SECURE=true para el puerto 465; false (STARTTLS) para el 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Remitente de los correos, p. ej. "Portfolios fotográficos <tu.cuenta@gmail.com>". Por defecto, SMTP_USER.
MAIL_FROM=
