{
  "name": "portfolio-backend",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "API sencilla que sirve el catálogo de colecciones/fotos y las imágenes estáticas del portfolio fotográfico.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:importar": "tsx src/scripts/importar-json.ts",
    "fotografo:renombrar": "tsx src/scripts/renombrar-fotografo.ts",
    "portfolio:renombrar": "tsx src/scripts/renombrar-portfolio.ts",
    "coleccion:renombrar": "tsx src/scripts/renombrar-portfolio.ts --coleccion",
    "fotos:convertir": "tsx src/scripts/convertir-fotos.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "opentype.js": "^1.3.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/opentype.js": "^1.3.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
