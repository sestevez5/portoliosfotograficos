# Variables del backend en desarrollo. Copia este fichero a "backend/.env" (no versionado ni incluido en la
# imagen Docker) y rellénalo: "npm run dev" lo carga al arrancar. Sin ".env", el backend funciona igual,
# pero no envía correos (los escribe en la consola). Los tests ("npm test") no lo cargan.
#
# En Docker (NAS) estas variables van en el ".env" de la raíz, junto a docker-compose.yml.

# Dirección de la web con la que se construyen los enlaces de los correos ("¿Has olvidado tu
# contraseña?"). En desarrollo, la de "ng serve".
PUBLIC_URL=http://localhost:4200

# Servidor de correo saliente. Con Gmail: puerto 465 con SMTP_SECURE=true, la cuenta en SMTP_USER y en
# SMTP_PASSWORD una "contraseña de aplicación" de Google (https://myaccount.google.com/apppasswords),
# no la contraseña de la cuenta. Deja SMTP_HOST vacío para no enviar correos.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu.cuenta@gmail.com
SMTP_PASSWORD=
# Remitente: la misma cuenta que SMTP_USER (Gmail no admite otra).
MAIL_FROM=Portfolios fotográficos <tu.cuenta@gmail.com>

# Otras carpetas de datos y fotos (opcional; por defecto backend/contenido/datos y backend/contenido/fotos).
# DATOS_DIR=../../copia/datos
# FOTOS_DIR=../../copia/fotos
